{
  "name": "paper-bridge",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/matcher"
  ],
  "scripts": {
    "test": "npm run test --workspace @paper-bridge/matcher && npm run test:geometry && npm run test:full-pdf && npm run test:source-fetch && npm run test:reading-ui && npm run test:bridge-runtime",
    "test:bridge-runtime": "node --test scripts/test-bridge-runtime.mjs",
    "test:full-pdf": "node --test scripts/test-full-pdf.mjs",
    "test:reading-ui": "node --test scripts/test-reading-ui.mjs",
    "test:source-fetch": "node --test scripts/test-source-fetch.mjs scripts/test-translated-rematch.mjs",
    "test:geometry": "node scripts/test-pdf-geometry.mjs && node --test scripts/test-geometry-edge-cases.mjs",
    "match:sample": "npm run match:sample --workspace @paper-bridge/matcher",
    "build:zotero": "npm run build --prefix packages/zotero-addon",
    "check:extension": "node scripts/check-extension.mjs",
    "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  }
}
